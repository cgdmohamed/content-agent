# Production runtime
NODE_ENV=production
PUBLIC_WEB_URL=https://content.example.com
VITE_API_URL=/api
API_PORT=3000

# PostgreSQL and Redis service URLs inside docker-compose.prod.yml
POSTGRES_USER=content_agent
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=content_agent
# DATABASE_URL and REDIS_URL are built inside docker-compose.yml from service names.
# Use URL-safe characters for POSTGRES_PASSWORD because it is embedded in DATABASE_URL.

# Security
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate once and keep it stable: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY_BASE64=cmVwbGFjZS13aXRoLTMyLWJ5dGUtYmFzZTY0LWtleSE=

# First admin, used only when the users table is empty
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-admin-password-2026!

# AI provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
PERPLEXITY_MODEL=sonar-pro
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Operations
WORKER_CONCURRENCY=2
MONTHLY_AI_BUDGET_USD=30
# Set to 0 only to disable the hard stop.
MONTHLY_AI_HARD_LIMIT_USD=40
