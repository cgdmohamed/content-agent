{
  "name": "@content-agent/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@content-agent/config": "workspace:*",
    "@content-agent/shared": "workspace:*",
    "bullmq": "^5.34.3",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "sanitize-html": "^2.17.7",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^5.7.2"
  }
}
