# Runtime
NODE_ENV=development
PUBLIC_WEB_URL=http://localhost:5173
# Use /api in production when the web bundle and API share the same origin.
VITE_API_URL=http://localhost:3000/api
API_PORT=3000

# Database and queue
DATABASE_URL=postgresql://content_agent:content_agent@localhost:5432/content_agent
REDIS_URL=redis://localhost:6379
POSTGRES_USER=content_agent
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=content_agent

# Security
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate once and keep it stable; changing it makes encrypted site secrets unreadable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login-2026!

# AI provider keys are optional until enabled in Settings
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
PERPLEXITY_MODEL=sonar-pro
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
WORKER_CONCURRENCY=2

# Cost controls
MONTHLY_AI_BUDGET_USD=30
# Set to 0 only to disable the hard stop.
MONTHLY_AI_HARD_LIMIT_USD=40

# Reverse proxies in front of the API (Coolify/Traefik + web nginx = 2; nginx only = 1; direct = 0).
# Wrong values make every user share one IP rate-limit bucket or let clients spoof X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Monitoring (all optional)
# Error tracking: leave empty to disable. Errors only; request bodies and cookies are never sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Enables GET /api/metrics (Prometheus) with "Authorization: Bearer <token>". Empty = endpoint disabled.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
METRICS_TOKEN=
# json (default in production) or pretty; debug|info|warn|error
LOG_FORMAT=
LOG_LEVEL=info

# Backups (docker-compose `backup` service: daily pg_dump, verified, pruned)
# Hour of day (UTC) for the daily backup; keep N daily and M weekly (Sunday) dumps on the backup volume.
BACKUP_HOUR_UTC=2
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# weekly = full restore test on Sundays, always = every run, never = only check the dump can be read
BACKUP_FULL_VERIFY=weekly
# Encrypt dumps with age. Put only the PUBLIC key here (age-keygen); keep the private key offline.
# Generate with: age-keygen -o backup-key.txt   (the "Public key: age1..." line)
BACKUP_AGE_RECIPIENT=
# Off-site copy to any S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO, Wasabi).
# Use WRITE-ONLY credentials and a bucket lifecycle rule for retention, so a compromised server cannot delete history.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=content-agent
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
# Refuse to upload unencrypted dumps unless you explicitly allow it.
BACKUP_ALLOW_PLAINTEXT_UPLOAD=false
# healthchecks.io / Uptime Kuma push URL: /start, success and /fail pings so a silent failure still alerts you.
BACKUP_PING_URL=
