# Runtime
NODE_ENV=development
PUBLIC_WEB_URL=http://localhost:5173
# Use /api in production when the web bundle and API share the same origin.
VITE_API_URL=http://localhost:3000/api
API_PORT=3000

# Database and queue
DATABASE_URL=postgresql://content_agent:content_agent@localhost:5432/content_agent
REDIS_URL=redis://localhost:6379
POSTGRES_USER=content_agent
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=content_agent

# Security
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate once and keep it stable; changing it makes encrypted site secrets unreadable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login-2026!

# AI provider keys are optional until enabled in Settings
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
PERPLEXITY_MODEL=sonar-pro
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
WORKER_CONCURRENCY=2

# Cost controls
MONTHLY_AI_BUDGET_USD=30
# Set to 0 only to disable the hard stop.
MONTHLY_AI_HARD_LIMIT_USD=40
